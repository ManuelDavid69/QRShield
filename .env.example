# Identifiants PostgreSQL locaux
POSTGRES_USER=qrshield
POSTGRES_PASSWORD=change_me
POSTGRES_DB=qrshield

# URL de connexion utilisée par le backend hors Docker
DATABASE_URL=postgresql+psycopg://qrshield:change_me@127.0.0.1:5432/qrshield

# Origines autorisées pour CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Clés des services externes de réputation (facultatives)
# Safe Browsing : https://developers.google.com/safe-browsing/v4/get-started
# VirusTotal : clé gratuite dans les paramètres du compte sur virustotal.com
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Clé de signature des tokens JWT (au moins 32 caractères, à générer avec
# python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=
